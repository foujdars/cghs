# Vercel server environment; never place these in browser JavaScript.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_TOKEN=
CRON_SECRET=
RUNNER_TOKEN=
# Optional: allow your public SlotCare frontend to call the Vercel API. Same-origin works without this.
ALLOWED_ORIGINS=https://cghs-slot-assistant.girjeshkumark-670291.chatgpt.site
# Local worker only, alongside RUNNER_TOKEN above:
SLOTCARE_URL=https://YOUR_APP.vercel.app
RUNNER_ID=my-computer
# Optional: PINNED CGHS browser profile only on your own machine:
CGHS_PROFILE=.private/cghs-profile
